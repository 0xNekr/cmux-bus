#!/usr/bin/env bash
# agent-lead-guard — Claude Code hook that turns the STRICT lead convention into
# real enforcement. As a hook it reads the event JSON on stdin; as a CLI it wires
# itself into settings.json.
#
#   agent-lead-guard                 (hook mode: reads stdin, emits a decision)
#   agent-lead-guard install [--user|--project]
#   agent-lead-guard uninstall [--user|--project]
#   agent-lead-guard status [--user|--project]
#
# When the current pane is the strict lead of its bus:
#   - PreToolUse Task/Agent  -> deny  (use agent-spawn to put workers on the bus)
#   - PreToolUse Edit/Write/NotebookEdit -> ask (delegate, or approve if the user
#     explicitly told the lead to edit)
#   - PreToolUse Bash        -> allow coordination/read-only commands; ask the rest
#   - UserPromptSubmit / SessionStart -> inject a "you are the strict lead" reminder
# In every other case (no cmux pane, no bus, not the lead, or relaxed) it exits 0
# and stays out of the way. Fail-open by design — it must never break a session.

# NOTE: no `set -e`. A guard bug must not block tools; we handle errors and
# default to allow (exit 0).
set -uo pipefail

AGENT_CMD="agent-lead-guard"
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
    script_dir="$(cd "$(dirname "$script_path")" && pwd)"
    link_target="$(readlink "$script_path")"
    case "$link_target" in
        /*) script_path="$link_target";;
        *)  script_path="$script_dir/$link_target";;
    esac
done
. "$(cd "$(dirname "$script_path")" && pwd)/agent-lib"

# ---------------------------------------------------------------------------
# CLI mode: install / uninstall / status
# ---------------------------------------------------------------------------

settings_target() {
    local scope="user"
    while [ $# -gt 0 ]; do
        case "$1" in
            --project) scope="project";;
            --user)    scope="user";;
        esac
        shift
    done
    if [ "$scope" = "project" ]; then
        printf '%s/.claude/settings.json\n' "$PWD"
    else
        printf '%s/.claude/settings.json\n' "$HOME"
    fi
}

do_install() {
    local file cmd tmp scope="user" a
    for a in "$@"; do
        case "$a" in --project) scope="project";; --user) scope="user";; esac
    done
    file="$(settings_target "$@")"
    if [ "$scope" = "project" ]; then
        # Portable + fail-safe command for a committable project settings file:
        # resolve via PATH and no-op when cmux-bus is not installed. This lets a
        # repo COMMIT .claude/settings.json so every cloner who has cmux-bus gets
        # the enforcement automatically, while cloners without it are unaffected.
        cmd='command -v agent-lead-guard >/dev/null 2>&1 && agent-lead-guard || true'
    else
        # User-level: absolute path to this clone (fastest, this machine only).
        cmd="$AGENT_BIN_DIR/agent-lead-guard"
    fi
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || echo '{}' > "$file"
    jq -e . "$file" >/dev/null 2>&1 || {
        echo "agent-lead-guard: $file is not valid JSON — aborting (nothing changed)" >&2
        return 1
    }
    cp "$file" "$file.bak-$(date -u +%Y%m%dT%H%M%SZ)"
    tmp="$(mktemp)"
    jq --arg cmd "$cmd" '
        def strip: map(select(((.hooks // []) | map(.command) | any(contains("agent-lead-guard"))) | not));
        .hooks //= {}
        | .hooks.PreToolUse //= []
        | .hooks.UserPromptSubmit //= []
        | .hooks.SessionStart //= []
        | .hooks.PreToolUse |= strip
        | .hooks.UserPromptSubmit |= strip
        | .hooks.SessionStart |= strip
        | .hooks.PreToolUse += [{matcher:"Edit|Write|NotebookEdit|Bash|Task|Agent", hooks:[{type:"command", command:$cmd}]}]
        | .hooks.UserPromptSubmit += [{matcher:"", hooks:[{type:"command", command:$cmd}]}]
        | .hooks.SessionStart += [{matcher:"", hooks:[{type:"command", command:$cmd}]}]
    ' "$file" > "$tmp" && mv "$tmp" "$file" || {
        echo "agent-lead-guard: failed to update $file" >&2
        return 1
    }
    echo "agent-lead-guard: installed into $file (timestamped backup kept)"
    echo "agent-lead-guard: gates Edit/Write/NotebookEdit/Bash/Task/Agent + injects a reminder for the strict lead"
    echo "agent-lead-guard: only acts when this pane is the strict lead — every other session is untouched"
}

do_uninstall() {
    local file tmp
    file="$(settings_target "$@")"
    [ -f "$file" ] || { echo "agent-lead-guard: $file does not exist — nothing to do"; return 0; }
    jq -e . "$file" >/dev/null 2>&1 || { echo "agent-lead-guard: $file is not valid JSON — aborting" >&2; return 1; }
    cp "$file" "$file.bak-$(date -u +%Y%m%dT%H%M%SZ)"
    tmp="$(mktemp)"
    jq '
        def strip: map(select(((.hooks // []) | map(.command) | any(contains("agent-lead-guard"))) | not));
        if .hooks then
            (if .hooks.PreToolUse then .hooks.PreToolUse |= strip else . end)
            | (if .hooks.UserPromptSubmit then .hooks.UserPromptSubmit |= strip else . end)
            | (if .hooks.SessionStart then .hooks.SessionStart |= strip else . end)
        else . end
    ' "$file" > "$tmp" && mv "$tmp" "$file"
    echo "agent-lead-guard: removed guard hooks from $file"
}

do_status() {
    local file
    file="$(settings_target "$@")"
    if [ ! -f "$file" ] || ! jq -e . "$file" >/dev/null 2>&1; then
        echo "agent-lead-guard: no usable settings at $file — not installed"
        return 0
    fi
    local n
    n="$(jq '[.hooks // {} | to_entries[] | .value[]? | .hooks[]? | select(.command | type=="string" and contains("agent-lead-guard"))] | length' "$file" 2>/dev/null)"
    if [ "${n:-0}" -gt 0 ]; then
        echo "agent-lead-guard: installed in $file ($n hook entr$( [ "$n" = 1 ] && echo y || echo ies ))"
        jq -r '.hooks // {} | to_entries[] | "  \(.key): " + ([.value[]? | .hooks[]? | select(.command|type=="string" and contains("agent-lead-guard")) | "on"] | length | tostring) + " entry(ies)"' "$file" 2>/dev/null
    else
        echo "agent-lead-guard: not installed in $file"
    fi
}

case "${1:-}" in
    install)   shift; do_install "$@"; exit $? ;;
    uninstall) shift; do_uninstall "$@"; exit $? ;;
    status)    shift; do_status "$@"; exit $? ;;
    -h|--help)
        sed -n '2,20p' "$script_path"; exit 0 ;;
esac

# ---------------------------------------------------------------------------
# Hook mode: read the event JSON from stdin and emit a decision
# ---------------------------------------------------------------------------

# If there is no piped input (run by hand in a terminal), show usage rather than
# hanging on a stdin read.
if [ -t 0 ]; then
    echo "usage: agent-lead-guard [install|uninstall|status] [--user|--project]" >&2
    echo "  (hook mode reads a Claude Code event JSON on stdin)" >&2
    exit 0
fi

input="$(cat 2>/dev/null || true)"
[ -n "$input" ] || exit 0
event="$(printf '%s' "$input" | jq -r '.hook_event_name // empty' 2>/dev/null || true)"
[ -n "$event" ] || exit 0

# Only ever act when this pane is the strict lead; otherwise stay invisible.
agent_bus_i_am_strict_lead 2>/dev/null || exit 0
me="$(agent_bus_current_agent 2>/dev/null || true)"
[ -n "$me" ] || me="the lead"

emit_decision() { # <permissionDecision> <reason>
    jq -nc --arg d "$1" --arg r "$2" \
        '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:$d,permissionDecisionReason:$r}}'
    exit 0
}

emit_context() { # <event> <context>
    jq -nc --arg e "$1" --arg c "$2" \
        '{hookSpecificOutput:{hookEventName:$e,additionalContext:$c}}'
    exit 0
}

# Detect a busy-wait / polling loop (a loop construct plus a sleep). The lead
# must not block on these: while a foreground poll runs, worker ack/done signals
# injected into the pane just queue behind it instead of waking the lead. Returns
# 0 when the command looks like bus polling.
bash_is_poll_loop() {
    local c
    c="$(printf '%s' "$1" | sed "s/'[^']*'//g; s/\"[^\"]*\"//g")"
    printf '%s' "$c" | grep -qiE '(^|[;&|`(]|[[:space:]])(for|while|until)[[:space:]]' \
        && printf '%s' "$c" | grep -qiE '(^|[;&|`(]|[[:space:]])sleep[[:space:]]'
}

# Blocklist, not allowlist: the strict lead reads and coordinates freely
# (reading is always fine), so a Bash command is allowed UNLESS it clearly
# executes or mutates. This avoids prompting on the lead's normal review/monitor
# work (gh pr list, loops, cmux read-screen, agent-*, git status, ...). Returns 0
# when the command should prompt (ask), 1 when it should be allowed.
bash_should_ask() {
    local cmd="$1" first c
    local b='(^|[;&|(`]|[[:space:]])'   # a word boundary that survives pipes/subshells

    # Bus/coordination commands are ALWAYS allowed: their arguments (a --task
    # description, --paths, a handoff message) are data, not commands the lead
    # runs. Checking the first real token avoids false positives like
    # `agent-spawn x --task "... docker ps ... ssh ..."`.
    first="$(printf '%s' "$cmd" | awk '{for(i=1;i<=NF;i++){ if($i ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue; print $i; exit }}')"
    first="$(basename "$first" 2>/dev/null || printf '%s' "$first")"
    case "$first" in
        agent-*|cmux) return 1 ;;
    esac

    # Strip quoted spans so blocklist words inside messages/patterns/--task text
    # do not trigger; what remains is the command structure.
    c="$(printf '%s' "$cmd" | sed "s/'[^']*'//g; s/\"[^\"]*\"//g")"

    # Build tools, package managers, language runtimes — "doing work".
    printf '%s' "$c" | grep -qiE "${b}(npm|yarn|pnpm|bun|make|cargo|go|mvn|gradle|pip|pip3|poetry|uv|python|python3|node|deno|ruby|rails|php|dotnet|rustc|tsc|vite|webpack|jest|vitest|pytest|terraform|ansible|kubectl|helm|docker|docker-compose|podman|vagrant|serverless)[[:space:]]" && return 0
    # Filesystem mutations.
    printf '%s' "$c" | grep -qiE "${b}(rm|mv|cp|chmod|chown|mkdir|rmdir|touch|ln|tee|dd|truncate)[[:space:]]" && return 0
    # In-place stream edits.
    printf '%s' "$c" | grep -qiE '(sed|perl)[[:space:]]+-i' && return 0
    # git mutations (read subcommands like status/log/diff stay allowed).
    printf '%s' "$c" | grep -qiE 'git[[:space:]]+(commit|push|merge|rebase|reset|checkout|switch|cherry-pick|revert|tag|am|apply|stash|clean|add|rm|mv)([[:space:]]|$)' && return 0
    # gh / forge mutations (read subcommands like pr list/view stay allowed).
    printf '%s' "$c" | grep -qiE 'gh[[:space:]]+(pr[[:space:]]+(create|merge|close|edit|review|comment|ready)|issue[[:space:]]+(create|close|edit|comment)|release|repo[[:space:]]+(create|delete|fork)|workflow[[:space:]]+run|api[[:space:]]+(-X[[:space:]]*)?(POST|PUT|PATCH|DELETE))' && return 0

    return 1
}

case "$event" in
    PreToolUse)
        tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)"
        case "$tool" in
            Task|Agent)
                emit_decision deny "You are '$me', the STRICT lead on the cmux bus. Native sub-agents are off the bus and invisible to peers. Use 'agent-spawn <name> --as <provider>' to put a worker on the bus, then delegate with 'agent-send <name> handoff --paths ...'."
                ;;
            Edit|Write|NotebookEdit)
                emit_decision ask "You are '$me', the STRICT lead — delegate file changes via 'agent-send <peer> handoff --paths ...' instead of editing yourself. Approve only if the user explicitly told you to edit directly."
                ;;
            Bash)
                cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
                if [ -n "$cmd" ] && bash_is_poll_loop "$cmd"; then
                    emit_decision ask "You are '$me', the STRICT lead — don't block on a polling loop. After delegating, END YOUR TURN: a worker's 'ack'/'done' is signalled into your pane and wakes you automatically; a foreground sleep-loop only makes those signals queue behind it. For a single blocking wait use 'agent-wait <id>' or 'agent-rpc'."
                elif [ -n "$cmd" ] && bash_should_ask "$cmd"; then
                    emit_decision ask "You are '$me', the STRICT lead — this command builds/runs/mutates rather than reads. Delegate it via the bus ('agent-send <peer> handoff'), or approve only if the user explicitly asked you to run it yourself."
                fi
                exit 0
                ;;
            *) exit 0 ;;
        esac
        ;;
    UserPromptSubmit|SessionStart)
        emit_context "$event" "cmux-bus: you are '$me', the STRICT LEAD on this bus. Plan and delegate — do NOT edit files, run shell commands, or spawn native Task/Agent sub-agents yourself (those are gated/blocked). Delegate every task with 'agent-send <peer> handoff --paths ...' or recruit workers with 'agent-spawn <name> --as <provider>'. Check the board first: 'agent-roster' then 'agent-inbox'. After delegating, END YOUR TURN — a worker's 'ack'/'done' is signalled into your pane and wakes you automatically; never block on a sleep/polling loop (it just makes those signals queue behind it). The only exception is an explicit user instruction to act yourself."
        ;;
    *) exit 0 ;;
esac
exit 0
