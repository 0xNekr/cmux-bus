#!/usr/bin/env bash

agent_script_path() {
    local script_path="$1"
    while [ -L "$script_path" ]; do
        local script_dir link_target
        script_dir="$(cd "$(dirname "$script_path")" && pwd)"
        link_target="$(readlink "$script_path")"
        case "$link_target" in
            /*) script_path="$link_target";;
            *)  script_path="$script_dir/$link_target";;
        esac
    done
    printf '%s\n' "$script_path"
}

AGENT_SCRIPT_PATH="$(agent_script_path "${BASH_SOURCE[1]}")"
AGENT_BIN_DIR="$(cd "$(dirname "$AGENT_SCRIPT_PATH")" && pwd)"
AGENT_REPO_ROOT="$(cd "$AGENT_BIN_DIR/.." && pwd)"

AGENT_BUS_CLI_SCOPE=""
AGENT_BUS_CLI_DIR=""
AGENT_BUS_REMAINING_ARGS=()

agent_bus_common_usage() {
    cat <<'EOF'
Common bus options:
  --scope repo|workspace  select the bus scope for this invocation
  --bus-dir DIR           use an explicit bus directory

Environment:
  AGENT_BUS_SCOPE=repo|workspace
  AGENT_BUS_DIR=/path/to/bus

Default scope is workspace.
EOF
}

agent_bus_parse_common() {
    AGENT_BUS_CLI_SCOPE=""
    AGENT_BUS_CLI_DIR=""
    AGENT_BUS_REMAINING_ARGS=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --scope)
                [ $# -ge 2 ] || { echo "${AGENT_CMD}: --scope needs repo or workspace" >&2; exit 2; }
                AGENT_BUS_CLI_SCOPE="$2"
                shift 2
                ;;
            --scope=*)
                AGENT_BUS_CLI_SCOPE="${1#--scope=}"
                shift
                ;;
            --bus-dir)
                [ $# -ge 2 ] || { echo "${AGENT_CMD}: --bus-dir needs a directory" >&2; exit 2; }
                AGENT_BUS_CLI_DIR="$2"
                shift 2
                ;;
            --bus-dir=*)
                AGENT_BUS_CLI_DIR="${1#--bus-dir=}"
                shift
                ;;
            --)
                shift
                while [ $# -gt 0 ]; do
                    AGENT_BUS_REMAINING_ARGS+=("$1")
                    shift
                done
                break
                ;;
            *)
                AGENT_BUS_REMAINING_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

agent_bus_scope() {
    local scope="${AGENT_BUS_CLI_SCOPE:-${AGENT_BUS_SCOPE:-workspace}}"
    case "$scope" in
        repo|workspace) printf '%s\n' "$scope";;
        *) echo "${AGENT_CMD}: invalid bus scope '$scope' (repo|workspace)" >&2; exit 2;;
    esac
}

agent_bus_state_home() {
    if [ -n "${XDG_STATE_HOME:-}" ]; then
        printf '%s\n' "$XDG_STATE_HOME"
    else
        printf '%s\n' "$HOME/.local/state"
    fi
}

agent_bus_workspace_id() {
    local id="${CMUX_WORKSPACE_ID:-}"
    if [ -z "$id" ] && command -v cmux >/dev/null 2>&1; then
        # Resolve the *caller's* workspace from its surface, never the focused
        # one. `cmux current-workspace` returns whichever workspace is currently
        # selected in the UI, which is wrong for a background agent pane and
        # would silently route it to a peer workspace's bus — the root cause of
        # "agents on the wrong bus" when several workspaces share one folder.
        # `cmux identify` is bound to this pane's CMUX_SURFACE_ID, so its
        # caller.workspace_id is always the workspace this command runs in.
        id="$(cmux identify --id-format both 2>/dev/null \
            | jq -r '.caller.workspace_id // empty' 2>/dev/null)"
    fi
    [ -n "$id" ] || {
        echo "${AGENT_CMD}: cannot determine cmux workspace id (CMUX_WORKSPACE_ID unset and 'cmux identify' gave no caller workspace); set AGENT_BUS_DIR or use --scope repo" >&2
        exit 1
    }
    printf '%s' "$id" | tr -c 'A-Za-z0-9._-' '_'
}

agent_bus_repo_root() {
    # Anchor --scope repo to the git toplevel, not pwd. The earlier relative
    # ".agents" path silently created the bus wherever the caller happened to
    # cd'd to, so peer panes ended up on disjoint registries and stopped seeing
    # each other.
    # Returns non-zero on failure; callers must propagate via `|| exit 1` so the
    # outer command substitution actually tears down the script instead of
    # silently continuing with an empty path.
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        echo "${AGENT_CMD}: --scope repo requires running inside a git repository (set AGENT_BUS_DIR or --bus-dir to override)" >&2
        return 1
    }
    printf '%s' "$root"
}

agent_bus_resolve_dir() {
    if [ -n "$AGENT_BUS_CLI_DIR" ]; then
        printf '%s\n' "$AGENT_BUS_CLI_DIR"
        return 0
    fi
    if [ -n "${AGENT_BUS_DIR:-}" ]; then
        printf '%s\n' "$AGENT_BUS_DIR"
        return 0
    fi

    case "$(agent_bus_scope)" in
        repo)
            local root
            root="$(agent_bus_repo_root)" || exit 1
            printf '%s/.agents\n' "$root"
            ;;
        workspace)
            printf '%s/cmux-bus/workspaces/%s\n' "$(agent_bus_state_home)" "$(agent_bus_workspace_id)"
            ;;
    esac
}

agent_bus_set_paths() {
    AGENT_BUS_SCOPE_EFFECTIVE="$(agent_bus_scope)"
    AGENT_BUS_DIR_EFFECTIVE="$(agent_bus_resolve_dir)"
    AGENT_BUS_FILE="$AGENT_BUS_DIR_EFFECTIVE/bus.jsonl"
    AGENT_BUS_LOCK="$AGENT_BUS_DIR_EFFECTIVE/bus.lock"
    AGENT_BUS_AGENTS_FILE="$AGENT_BUS_DIR_EFFECTIVE/agents.json"
    AGENT_BUS_PROTOCOL_FILE="$AGENT_BUS_DIR_EFFECTIVE/PROTOCOL.md"
    AGENT_BUS_REPO_RUNTIME=0
    if [ "$AGENT_BUS_SCOPE_EFFECTIVE" = "repo" ] && [ -z "$AGENT_BUS_CLI_DIR" ] && [ -z "${AGENT_BUS_DIR:-}" ]; then
        AGENT_BUS_REPO_RUNTIME=1
    fi
}

agent_bus_export_env() {
    export AGENT_BUS_SCOPE="$AGENT_BUS_SCOPE_EFFECTIVE"
    export AGENT_BUS_DIR="$AGENT_BUS_DIR_EFFECTIVE"
}

agent_bus_need_existing() {
    [ -d "$AGENT_BUS_DIR_EFFECTIVE" ] && [ -f "$AGENT_BUS_FILE" ] || {
        echo "${AGENT_CMD}: no bus at $AGENT_BUS_DIR_EFFECTIVE — run 'agent-init <your_name>' first" >&2
        exit 1
    }
}

agent_bus_need_agents() {
    [ -f "$AGENT_BUS_AGENTS_FILE" ] || {
        echo "${AGENT_CMD}: no agents registry at $AGENT_BUS_AGENTS_FILE — run 'agent-init <your_name>' first" >&2
        exit 1
    }
}

# Snapshot the set of live terminal surfaces, one per line. Closed panes drop out
# of surface-health; a backgrounded-but-alive pane stays — do NOT filter on
# in_window=true, which only marks the focused workspace and would make alive
# peers in other workspaces look dead. Shared by every command that probes peer
# liveness (agent-send, agent-spawn, agent-watchdog, agent-recover, ...).
agent_bus_live_surfaces() {
    local output
    if ! output="$(cmux --id-format both surface-health 2>&1)"; then
        if printf '%s' "$output" | grep -qiE 'operation not permitted|permission denied|sandbox'; then
            echo "${AGENT_CMD}: cmux access denied by the sandbox (Unix socket)" >&2
            echo "${AGENT_CMD}: launch Codex through 'agent-spawn' auto mode, upgrade cmux-bus, or use --yolo explicitly" >&2
        else
            echo "${AGENT_CMD}: cmux surface-health failed: $output" >&2
        fi
        return 0
    fi
    printf '%s\n' "$output" | awk '/type=terminal/ {print $2}'
}

# ---- Watchdog auto-activation ----
# The watchdog only protects a lead if it is actually running. Rather than rely on
# someone launching it by hand, a lead that delegates (agent-spawn) starts a
# detached daemon for the bus, tracked by <bus-dir>/watchdog.pid so we never run
# two. agent-dismiss stops it when the team is gone. Opt out with
# AGENT_BUS_NO_WATCHDOG (used by the test suite so it doesn't fork daemons).

agent_bus_watchdog_running() {
    local pidfile="$1/watchdog.pid" pid
    [ -f "$pidfile" ] || return 1
    pid="$(cat "$pidfile" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

agent_bus_ensure_watchdog() {
    local bus_dir="$1" bin_dir="$2" interval="${3:-30}"
    [ -n "${AGENT_BUS_NO_WATCHDOG:-}" ] && return 0
    agent_bus_watchdog_running "$bus_dir" && return 0
    [ -x "$bin_dir/agent-watchdog" ] || return 0
    nohup "$bin_dir/agent-watchdog" --bus-dir "$bus_dir" daemon --interval "$interval" >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$bus_dir/watchdog.pid"
    disown 2>/dev/null || true
    return 0
}

agent_bus_stop_watchdog() {
    local pidfile="$1/watchdog.pid" pid
    [ -f "$pidfile" ] || return 0
    pid="$(cat "$pidfile" 2>/dev/null)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    rm -f "$pidfile" 2>/dev/null || true
    return 0
}

# ---- Bus lock (used by agent_bus_append_event) ----
# The bus lock is a directory (atomic mkdir). We stamp it with the holder's
# host+PID+epoch in an `owner` file so a *stale* lock — one left behind by a
# holder that was SIGKILLed (no EXIT trap fires) or by a crashed pane — can be
# detected and broken instead of deadlocking every future writer forever. This
# is the root-cause fix for the observed "agent-done: timed out waiting for bus
# lock" under contention.

# Portable mtime (epoch seconds) of a path; empty if it can't be read.
agent_bus_mtime() {
    local stamp
    # GNU stat may print filesystem data before rejecting BSD's -f %m form.
    # Capture each attempt separately so failed output cannot enter arithmetic.
    if stamp="$(stat -f %m "$1" 2>/dev/null)" || stamp="$(stat -c %Y "$1" 2>/dev/null)"; then
        case "$stamp" in ''|*[!0-9]*) return 0;; esac
        printf '%s\n' "$stamp"
    fi
    return 0
}

# Stable-ish host id so we only trust `kill -0` for a holder on the same host.
agent_bus_hostid() {
    printf '%s' "${HOSTNAME:-$(hostname 2>/dev/null || echo unknown)}"
}

# Decide whether the currently-held lock is stale. True (0) when the owning PID
# is on this host and no longer alive, or when the lock dir is older than
# $stale_after seconds (covers a missing/unreadable owner file and cross-host
# holders we cannot probe).
agent_bus_lock_is_stale() {
    local owner_file="$1" stale_after="$2"
    local host pid ts now lock_mtime
    now="$(date +%s)"
    if [ -r "$owner_file" ]; then
        read -r host pid ts < "$owner_file" 2>/dev/null || true
        if [ -n "${pid:-}" ] && [ "${host:-}" = "$(agent_bus_hostid)" ]; then
            kill -0 "$pid" 2>/dev/null && return 1   # holder alive -> not stale
            return 0                                  # holder gone  -> stale
        fi
    fi
    lock_mtime="$(agent_bus_mtime "$AGENT_BUS_LOCK")"
    [ -n "$lock_mtime" ] || return 1
    [ $(( now - lock_mtime )) -ge "$stale_after" ]
}

agent_bus_lock_holder_note() {
    local owner_file="$1" host pid ts
    [ -r "$owner_file" ] || return 0
    read -r host pid ts < "$owner_file" 2>/dev/null || true
    [ -n "${pid:-}" ] && printf ' (held by pid %s on %s)' "$pid" "${host:-?}"
    return 0
}

agent_bus_append_event() {
    local event="$1"

    case "$event" in
        *$'\n'*|*$'\r'*)
            echo "${AGENT_CMD}: refusing to append event with raw newline/control characters" >&2
            exit 1
            ;;
    esac

    printf '%s\n' "$event" | jq -e '
        type == "object"
        and (.id | type == "string")
        and (.ts | type == "string")
        and (.from | type == "string")
        and (.to | type == "string")
        and (.type | IN("ask","handoff","done","block","ack","timeout","reassigned"))
        and ((.ref == null) or (.ref | type == "string"))
        and (.status | IN("open","in_progress","done","blocked"))
        and (.paths_claimed | type == "array")
        and ((.cwd == null) or (.cwd | type == "string"))
        and ((.claims_cwd == null) or (.claims_cwd | type == "string"))
        and (.body | type == "string")
        and ((.ttl == null) or (.ttl | type == "number"))
        and ((.ack_by == null) or (.ack_by | type == "number"))
        and ((.created_at == null) or (.created_at | type == "number"))
        and ((.stale_after == null) or (.stale_after | type == "number"))
        and ((.hard_deadline == null) or (.hard_deadline | type == "number"))
    ' >/dev/null || {
        echo "${AGENT_CMD}: generated event does not match the bus schema" >&2
        exit 1
    }

    local owner_file="$AGENT_BUS_LOCK/owner"
    local stale_after="${AGENT_BUS_LOCK_STALE_SECS:-30}"
    local max_wait="${AGENT_BUS_LOCK_TIMEOUT_SECS:-30}"
    local deadline=$(( $(date +%s) + max_wait ))

    trap 'rm -rf "$AGENT_BUS_LOCK" 2>/dev/null || true' EXIT INT TERM
    while ! mkdir "$AGENT_BUS_LOCK" 2>/dev/null; do
        # Contended. Break the lock if its holder is dead or it has gone stale,
        # then retry; otherwise back off (with jitter to avoid lockstep) until the
        # deadline. mkdir stays the single atomic arbiter, so even if two writers
        # break-and-retry at once, only one wins the next mkdir.
        if agent_bus_lock_is_stale "$owner_file" "$stale_after"; then
            rm -rf "$AGENT_BUS_LOCK" 2>/dev/null || true
            continue
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "${AGENT_CMD}: timed out waiting for bus lock ($AGENT_BUS_LOCK)$(agent_bus_lock_holder_note "$owner_file")" >&2
            trap - EXIT INT TERM
            exit 1
        fi
        sleep "0.$(( (RANDOM % 3) + 1 ))"
    done

    printf '%s %s %s\n' "$(agent_bus_hostid)" "$$" "$(date +%s)" > "$owner_file" 2>/dev/null || true
    printf '%s\n' "$event" >> "$AGENT_BUS_FILE"
    rm -rf "$AGENT_BUS_LOCK"
    trap - EXIT INT TERM
}

agent_bus_current_agent() {
    local surface="${CMUX_SURFACE_ID:-}"
    [ -n "$surface" ] || return 0
    [ -f "$AGENT_BUS_AGENTS_FILE" ] || return 0
    jq -r --arg s "$surface" '.agents | to_entries[] | select(.value == $s) | .key' "$AGENT_BUS_AGENTS_FILE" | head -n1
}

agent_bus_lead() {
    [ -f "$AGENT_BUS_AGENTS_FILE" ] || return 0
    jq -r '.lead // empty' "$AGENT_BUS_AGENTS_FILE"
}

# ---- Provider registry (agent-spawn / agent-fleet) ----
# Resolution: built-in defaults below, deep-merged with a user config at
# $AGENT_BUS_PROVIDERS_FILE or ${XDG_CONFIG_HOME:-~/.config}/cmux-bus/providers.json
# if it exists (file wins per field, and may add new providers). Each provider
# has a `launch` command, a `model_flag`, and a `default_model`. The launch line
# is "<launch> <model_flag> <model>" unless the resolved model is empty.

agent_providers_file() {
    if [ -n "${AGENT_BUS_PROVIDERS_FILE:-}" ]; then
        printf '%s\n' "$AGENT_BUS_PROVIDERS_FILE"
        return 0
    fi
    printf '%s/cmux-bus/providers.json\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

agent_providers_builtin() {
    # model_style: "flag" -> "<launch> <model_flag> <model>" (claude, codex);
    #              "opencode" -> "OPENCODE_CONFIG_CONTENT='{\"model\":\"<model>\"}' <launch>"
    #              because the opencode TUI has no --model flag (only `opencode run`
    #              does); the model must come from config, which OPENCODE_CONFIG_CONTENT
    #              injects inline at local precedence.
    # opencode default_model is empty: with no --model, opencode keeps its own
    # configured default; --model then overrides it via the inline config.
    cat <<'JSON'
{
  "providers": {
    "claude":   { "launch": "claude",   "model_style": "flag", "model_flag": "--model", "default_model": "opus" },
    "codex":    { "launch": "codex",    "model_style": "flag", "model_flag": "--model", "default_model": "gpt-5.4" },
    "opencode": { "launch": "opencode", "model_style": "opencode", "default_model": "" }
  }
}
JSON
}

agent_providers_json() {
    local f
    f="$(agent_providers_file)"
    if [ -f "$f" ]; then
        # Deep-merge builtin (base) with the user file (override/extend). Fall
        # back to builtin if the file is malformed rather than breaking spawn.
        jq -s '.[0] * .[1]' <(agent_providers_builtin) "$f" 2>/dev/null \
            || agent_providers_builtin
    else
        agent_providers_builtin
    fi
}

agent_provider_known() {
    local p="$1"
    agent_providers_json | jq -e --arg p "$p" '.providers[$p] != null' >/dev/null 2>&1
}

agent_provider_field() {
    local p="$1" field="$2"
    agent_providers_json | jq -r --arg p "$p" --arg f "$field" '.providers[$p][$f] // empty'
}

agent_provider_names() {
    agent_providers_json | jq -r '.providers | keys[]'
}

# ---- Worker metadata (agent-spawn / agent-dismiss / agent-roster) ----
# agents.json carries an optional `.meta` map parallel to `.agents`:
#   .meta[name] = {provider, model, spawned_by, spawned_at}
# It is purely additive — every command that reads `.agents[name]` (a surface
# string) keeps working whether or not `.meta` is present.

agent_meta_get() {
    # agent_meta_get <name> <field> -> prints value or empty
    local name="$1" field="$2"
    [ -f "$AGENT_BUS_AGENTS_FILE" ] || return 0
    jq -r --arg n "$name" --arg f "$field" '.meta[$n][$f] // empty' "$AGENT_BUS_AGENTS_FILE"
}

# Durable worktree records deliberately outlive the surface registry.
agent_worktree_record() {
    [[ "$1" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || return 1
    printf '%s/worktrees/records/%s.json\n' "$AGENT_BUS_DIR_EFFECTIVE" "$1"
}

agent_worktree_json() {
    local record
    record="$(agent_worktree_record "$1")" || { printf 'null\n'; return 0; }
    if [ -f "$record" ]; then
        jq -c 'if .status == "removed" then null else . end' "$record"
    else
        printf 'null\n'
    fi
}

# These locks protect registry updates and Git lifecycle operations, independently
# of bus appends. Never steal a live local process's lock during a long check.
agent_operation_unlock() {
    local lock
    for lock in ${AGENT_OPERATION_LOCKS[@]+"${AGENT_OPERATION_LOCKS[@]}"}; do
        if [ "$(cat "$lock/owner" 2>/dev/null)" = "${AGENT_OPERATION_OWNER:-}" ]; then
            rm -f "$lock/owner"
            rmdir "$lock" 2>/dev/null || true
        fi
    done
    AGENT_OPERATION_LOCKS=()
}

agent_operation_lock() {
    local lock="$1" deadline host pid token stamp observed
    deadline=$(( $(date +%s) + ${AGENT_BUS_LOCK_TIMEOUT_SECS:-30} ))
    while ! mkdir "$lock" 2>/dev/null; do
        host=""; pid=""
        if [ -r "$lock/owner" ]; then
            observed="$(cat "$lock/owner" 2>/dev/null || true)"
            read -r host pid token < "$lock/owner" || true
            if [ "$host" = "$(agent_bus_hostid)" ] && [[ "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null; then
                # Only one contender may reap a dead owner; recheck after
                # acquiring the reaper so a new owner is never removed.
                if mkdir "$lock/reap" 2>/dev/null; then
                    if [ "$(cat "$lock/owner" 2>/dev/null)" = "$observed" ]; then rm -f "$lock/owner"; fi
                    rmdir "$lock/reap" 2>/dev/null || true
                    rmdir "$lock" 2>/dev/null || true
                fi
            fi
        else
            stamp="$(agent_bus_mtime "$lock")"
            if [[ "$stamp" =~ ^[0-9]+$ ]] && [ $(( $(date +%s) - stamp )) -ge 30 ]; then
                rmdir "$lock" 2>/dev/null || true
            fi
        fi
        [ "$(date +%s)" -lt "$deadline" ] || {
            echo "${AGENT_CMD}: timed out waiting for $lock" >&2; return 1;
        }
        sleep 0.1
    done
    AGENT_OPERATION_LOCKS+=("$lock")
    [ -n "${AGENT_OPERATION_OWNER:-}" ] || AGENT_OPERATION_OWNER="$(agent_bus_hostid) $$ $RANDOM"
    printf '%s\n' "$AGENT_OPERATION_OWNER" > "$lock/owner"
    trap 'agent_operation_unlock' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

agent_registry_update() (
    # The subshell must not release locks held by its parent (e.g. spawn).
    AGENT_OPERATION_LOCKS=()
    AGENT_OPERATION_OWNER=""
    agent_operation_lock "$AGENT_BUS_DIR_EFFECTIVE/registry.lock" || exit 1
    local tmp
    tmp="$(mktemp "$AGENT_BUS_AGENTS_FILE.tmp.XXXXXX")"
    jq "$@" "$AGENT_BUS_AGENTS_FILE" > "$tmp" && mv "$tmp" "$AGENT_BUS_AGENTS_FILE"
)

agent_worktree_common_dir() {
    local dir
    dir="$(git -C "$1" rev-parse --git-common-dir)" || return 1
    case "$dir" in /*) ;; *) dir="$1/$dir";; esac
    (cd "$dir" && pwd -P)
}

# ---- Lead execution policy ----
# When a lead is set, it defaults to STRICT: the lead plans and delegates and
# does NOT edit/run/execute anything itself, except on an explicit user
# instruction. Stored as optional "lead_policy" in agents.json; absent => strict.
# Only meaningful when a lead is set — callers should check agent_bus_lead first.
agent_bus_lead_policy() {
    [ -f "$AGENT_BUS_AGENTS_FILE" ] || { printf 'strict\n'; return 0; }
    case "$(jq -r '.lead_policy // empty' "$AGENT_BUS_AGENTS_FILE")" in
        relaxed) printf 'relaxed\n';;
        *)       printf 'strict\n';;
    esac
}

# Fast, fail-open check used by the lead guard hook: returns 0 only when the
# current pane is the bus lead AND the policy is strict. Returns non-zero in
# every other case (no cmux pane, no bus, not registered, not the lead, or
# relaxed) so a guard can early-exit and never interfere with normal sessions.
# Resolves the bus from env only (CMUX_SURFACE_ID / CMUX_WORKSPACE_ID) to stay
# cheap enough to run on every tool call — no cmux socket round-trip.
agent_bus_i_am_strict_lead() {
    [ -n "${CMUX_SURFACE_ID:-}" ] || return 1
    agent_bus_set_paths 2>/dev/null || return 1
    [ -f "$AGENT_BUS_AGENTS_FILE" ] || return 1
    local me lead
    me="$(jq -r --arg s "$CMUX_SURFACE_ID" '.agents | to_entries[] | select(.value == $s) | .key' "$AGENT_BUS_AGENTS_FILE" 2>/dev/null | head -n1)"
    [ -n "$me" ] || return 1
    lead="$(jq -r '.lead // empty' "$AGENT_BUS_AGENTS_FILE" 2>/dev/null)"
    [ "$me" = "$lead" ] || return 1
    [ "$(agent_bus_lead_policy)" = "strict" ] || return 1
    return 0
}

# ---- Spawn call policy ----
# Controls which agents may CREATE new agents via agent-spawn / agent-fleet.
# Resolution: built-in default (open) deep-merged with a user policy then a repo
# policy (repo wins, file fields win). Override the whole stack with
# $AGENT_BUS_POLICY_FILE. Rules are keyed by the caller's provider, the special
# "lead" role, or "default"; values are lists of allowed target providers (or
# ["*"]). Modes: "open" (anyone), "lead-only", "matrix" (consult rules).

agent_policy_user_file() {
    printf '%s/cmux-bus/policy.json\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

agent_policy_repo_file() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
    printf '%s/.cmux-bus/policy.json\n' "$root"
}

agent_policy_builtin() {
    printf '%s\n' '{"spawn":{"mode":"open","rules":{}}}'
}

# Merge a JSON file onto a base JSON string (deep merge, file wins). Echoes the
# base unchanged if the file is missing or malformed.
agent_policy_merge_file() {
    local base="$1" file="$2"
    if [ -n "$file" ] && [ -f "$file" ]; then
        jq -s '.[0] * .[1]' <(printf '%s' "$base") "$file" 2>/dev/null || printf '%s' "$base"
    else
        printf '%s' "$base"
    fi
}

agent_policy_json() {
    local out
    out="$(agent_policy_builtin)"
    if [ -n "${AGENT_BUS_POLICY_FILE:-}" ]; then
        out="$(agent_policy_merge_file "$out" "$AGENT_BUS_POLICY_FILE")"
        printf '%s\n' "$out"
        return 0
    fi
    out="$(agent_policy_merge_file "$out" "$(agent_policy_user_file)")"
    out="$(agent_policy_merge_file "$out" "$(agent_policy_repo_file || true)")"
    printf '%s\n' "$out"
}

# Policy identity of a caller name: "lead" if it is the bus lead, else its
# declared provider (from .meta), else "default".
agent_policy_caller_key() {
    local name="$1" lead prov
    lead="$(agent_bus_lead)"
    if [ -n "$lead" ] && [ "$name" = "$lead" ]; then printf 'lead\n'; return 0; fi
    prov="$(agent_meta_get "$name" provider)"
    if [ -n "$prov" ]; then printf '%s\n' "$prov"; else printf 'default\n'; fi
}

# Decide whether a <caller key> (a provider, "lead", or "default") may spawn a
# <target provider>. Pure policy logic — no bus access. Echoes "allow" or
# "deny: <reason>".
agent_spawn_decision_key() {
    local key="$1" target="$2"
    local policy mode allowed
    policy="$(agent_policy_json)"
    mode="$(printf '%s' "$policy" | jq -r '.spawn.mode // "open"')"
    case "$mode" in
        open)
            printf 'allow\n'
            ;;
        lead-only)
            if [ "$key" = "lead" ]; then
                printf 'allow\n'
            else
                printf 'deny: spawn policy is lead-only; only the lead may spawn\n'
            fi
            ;;
        matrix)
            # The lead may spawn anything unless an explicit "lead" rule narrows it.
            if [ "$key" = "lead" ] && ! printf '%s' "$policy" | jq -e '.spawn.rules.lead' >/dev/null 2>&1; then
                printf 'allow\n'
            else
                allowed="$(printf '%s' "$policy" | jq -r --arg k "$key" '(.spawn.rules[$k] // .spawn.rules.default // []) | .[]' 2>/dev/null)"
                if printf '%s\n' "$allowed" | grep -qxF '*' || printf '%s\n' "$allowed" | grep -qxF "$target"; then
                    printf 'allow\n'
                else
                    printf 'deny: spawn policy (matrix) does not allow "%s" to spawn "%s"\n' "$key" "$target"
                fi
            fi
            ;;
        *)
            printf 'deny: unknown spawn policy mode "%s"\n' "$mode"
            ;;
    esac
}

# Decide whether <caller name> may spawn a <target provider>, resolving the
# caller's policy key from the bus (lead role / declared provider / default).
agent_spawn_decision() {
    agent_spawn_decision_key "$(agent_policy_caller_key "$1")" "$2"
}

agent_bus_open_thread_count() {
    local bus_file="$1"
    [ -f "$bus_file" ] || { printf '0\n'; return 0; }
    jq -Rsr '
        def root($m;$e):
            if ($e.ref == null or ($m[$e.ref] == null)) then $e.id else root($m;$m[$e.ref]) end;

        split("\n")
        | map(fromjson?)
        | map(select(type == "object" and (.id | type == "string"))) as $events
        | ($events | map({key:.id, value:.}) | from_entries) as $m
        | ($events
            | map(. + {root: root($m;.)})
            | group_by(.root)
            | map({root: .[0].root, last: .[-1]})
          )
        | map(select(.last.status | IN("done","blocked") | not))
        | length
    ' "$bus_file"
}

agent_bus_write_workspace_stub() {
    local stub_dir="${1:-.agents}"
    local archive_note="${2:-}"
    mkdir -p "$stub_dir"

    # This stub lives in the *folder*, but the bus is scoped per cmux
    # *workspace*. One folder can be open in several workspaces at once, each
    # with its own separate bus, so the stub must never hardcode a single
    # resolved bus path — whichever workspace ran agent-init last would win and
    # point every other workspace's agents at the wrong bus. Describe the
    # resolution rule instead and let the agent commands resolve per pane.
    local state_home
    state_home="$(agent_bus_state_home)"

    cat > "$stub_dir/PROTOCOL.md" <<EOF
# cmux-bus workspace-scope stub

This .agents directory is NOT the active bus. The active bus is scoped to your
cmux workspace, not to this folder. This folder may be open in several cmux
workspaces at once, each with its own separate bus, so a single file here cannot
name the right one for everyone — it deliberately does not.

Always use the agent commands. They resolve the bus for *your* pane from its
CMUX_WORKSPACE_ID:

\`\`\`sh
agent-inbox
agent-send <peer> <type> <body>
agent-done <id> <body>
\`\`\`

Bus location (resolved per workspace — do not hardcode):

\`\`\`txt
$state_home/cmux-bus/workspaces/<your-cmux-workspace-id>/
\`\`\`

Do not read .agents/agents.json or .agents/bus.jsonl as the source of truth.
Do not use cmux send as a fallback when a peer is missing; ask the peer to run
\`agent-init <name>\` in their current pane.

Use \`--scope repo\` only when you intentionally want a folder-local legacy bus
shared by every workspace that opens this folder.
$archive_note
EOF

    cat > "$stub_dir/README.md" <<EOF
# cmux-bus stub

The active bus is workspace-scoped: each cmux workspace that opens this folder
gets its own bus under

\`\`\`txt
$state_home/cmux-bus/workspaces/<your-cmux-workspace-id>/
\`\`\`

Run \`agent-inbox\` and \`agent-send\` instead of reading files in this
directory; they resolve the right workspace bus for your pane. This stub exists
to prevent stale folder-local bus files from misleading agents.
$archive_note
EOF
}
