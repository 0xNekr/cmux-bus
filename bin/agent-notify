#!/usr/bin/env bash
# Automatic, read-only bridge from bus events to native cmux notifications.

set -euo pipefail

AGENT_CMD="agent-notify"
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
    script_dir="$(cd "$(dirname "$script_path")" && pwd)"
    link_target="$(readlink "$script_path")"
    case "$link_target" in
        /*) script_path="$link_target";;
        *)  script_path="$script_dir/$link_target";;
    esac
done
. "$(cd "$(dirname "$script_path")" && pwd)/agent-lib"

usage() {
    cat >&2 <<'EOF'
usage: agent-notify [--scope repo|workspace] [--bus-dir DIR] <command> [options]

Commands:
  enable [--interval SEC] [--label TEXT] [--replay] enable persistent notifications
  disable                                          persistently disable notifications
  ensure [--interval SEC] [--label TEXT]            enable unless explicitly disabled
  start [options]                                   alias for enable
  stop                                              alias for disable
  status                                            show enabled/disabled and runtime state
  once [--label TEXT] [--replay]                   process pending events once
  run [--interval SEC] [--label TEXT]              run in the foreground

Notifications are enabled automatically by agent-init. `disable` is a durable
per-bus opt-out; `enable` removes it. A persistent macOS LaunchAgent keeps the
notifier alive across terminal, cmux, and login restarts. The notifier is
read-only with respect to bus.jsonl and starts at the current end by default.
EOF
    agent_bus_common_usage >&2
    exit 2
}

display_name() {
    printf '%s\n' "$1" | awk -F '[-_]' '{
        for (i = 1; i <= NF; i++) {
            if (i > 1) printf " "
            printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2)
        }
    }'
}

is_running() {
    [ -f "$pid_file" ] || return 1
    pid="$(sed -n '1p' "$pid_file" 2>/dev/null || true)"
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    kill -0 "$pid" 2>/dev/null
}

stop_process() {
    local tries=0
    if is_running; then
        kill "$pid" 2>/dev/null || true
        while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 50 ]; do
            sleep 0.1
            tries=$((tries + 1))
        done
    fi
    rm -f "$pid_file"
}

write_cursor() {
    local value="$1" tmp
    tmp="$cursor_file.tmp.$$"
    printf '%s\n' "$value" > "$tmp"
    mv "$tmp" "$cursor_file"
}

xml_escape() {
    printf '%s' "$1" | sed \
        -e 's/&/\&amp;/g' \
        -e 's/</\&lt;/g' \
        -e 's/>/\&gt;/g' \
        -e 's/"/\&quot;/g' \
        -e "s/'/\\&apos;/g"
}

resolve_label() {
    local detected=""
    if [ -n "$label" ]; then
        return 0
    fi
    if [ -f "$label_file" ]; then
        label="$(sed -n '1p' "$label_file" 2>/dev/null || true)"
    fi
    if [ -z "$label" ] && [ -n "$workspace_id" ]; then
        detected="$(cmux --id-format both tree --workspace "$workspace_id" 2>/dev/null \
            | sed -n '1s/.*"\([^"]*\)".*/\1/p')"
        [ -n "$detected" ] && label="$detected"
    fi
    [ -n "$label" ] || label="cmux-bus"
}

stage_runtime() {
    mkdir -p "$runtime_dir"
    if [ "$AGENT_SCRIPT_PATH" != "$runtime_script" ]; then
        install -m 755 "$AGENT_SCRIPT_PATH" "$runtime_script"
    fi
    if [ "$AGENT_BIN_DIR/agent-lib" != "$runtime_dir/agent-lib" ]; then
        install -m 644 "$AGENT_BIN_DIR/agent-lib" "$runtime_dir/agent-lib"
    fi
}

launch_service_running() {
    command -v launchctl >/dev/null 2>&1 || return 1
    launchctl print "$launch_domain/$service_label" >/dev/null 2>&1
}

write_launch_agent() {
    local tmp label_xml runtime_xml bus_xml notify_label_xml path_xml home_xml socket_xml workspace_xml
    mkdir -p "$launch_agents_dir" "$state_dir"
    tmp="$plist_file.tmp.$$"
    label_xml="$(xml_escape "$service_label")"
    runtime_xml="$(xml_escape "$runtime_script")"
    bus_xml="$(xml_escape "$AGENT_BUS_DIR_EFFECTIVE")"
    notify_label_xml="$(xml_escape "$label")"
    path_xml="$(xml_escape "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin")"
    home_xml="$(xml_escape "$HOME")"
    socket_xml="$(xml_escape "$socket_path")"
    workspace_xml="$(xml_escape "$workspace_id")"
    cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label_xml</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$runtime_xml</string>
    <string>--bus-dir</string>
    <string>$bus_xml</string>
    <string>run</string>
    <string>--label</string>
    <string>$notify_label_xml</string>
    <string>--interval</string>
    <string>$interval</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>$home_xml</string>
    <key>PATH</key><string>$path_xml</string>
    <key>CMUX_SOCKET_PATH</key><string>$socket_xml</string>
    <key>CMUX_WORKSPACE_ID</key><string>$workspace_xml</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>$(xml_escape "$state_dir/launchd.out")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$state_dir/launchd.err")</string>
</dict>
</plist>
EOF
    mv "$tmp" "$plist_file"
}

enable_persistent() {
    local reset_cursor="$1"
    command -v launchctl >/dev/null 2>&1 || {
        echo "agent-notify: launchctl is required for persistent notifications" >&2
        return 1
    }
    resolve_label
    stage_runtime
    rm -f "$disabled_file"
    printf '%s\n' "$label" > "$label_file"
    if [ "$replay" -eq 1 ]; then
        write_cursor 0
    elif [ "$reset_cursor" -eq 1 ] || [ ! -f "$cursor_file" ]; then
        write_cursor "$(wc -l < "$AGENT_BUS_FILE" | tr -d ' ')"
    fi
    write_launch_agent
    launchctl bootout "$launch_domain/$service_label" >/dev/null 2>&1 || true
    stop_process
    launchctl bootstrap "$launch_domain" "$plist_file"
    launchctl kickstart -k "$launch_domain/$service_label" >/dev/null 2>&1 || true
    echo "agent-notify: enabled for $AGENT_BUS_DIR_EFFECTIVE ($label)"
}

disable_persistent() {
    touch "$disabled_file"
    if command -v launchctl >/dev/null 2>&1; then
        launchctl bootout "$launch_domain/$service_label" >/dev/null 2>&1 || true
    fi
    stop_process
    rm -f "$plist_file" "$pid_file"
    echo "agent-notify: disabled for $AGENT_BUS_DIR_EFFECTIVE"
}

notification_target() {
    local recipient="$1"
    jq -r --arg recipient "$recipient" '.agents[$recipient] // empty' "$AGENT_BUS_AGENTS_FILE" 2>/dev/null || true
}

send_notification() {
    local event="$1" type from to ref body from_label to_label title subtitle target

    type="$(printf '%s\n' "$event" | jq -r '.type // empty')"
    case "$type" in
        handoff|ask|done|block|timeout) ;;
        *) return 0;;
    esac

    from="$(printf '%s\n' "$event" | jq -r '.from // "agent"')"
    to="$(printf '%s\n' "$event" | jq -r '.to // "user"')"
    ref="$(printf '%s\n' "$event" | jq -r '.ref // empty')"
    body="$(printf '%s\n' "$event" | jq -r '(.body // "") | gsub("[\\r\\n\\t ]+"; " ") | .[0:180]')"
    from_label="$(display_name "$from")"
    to_label="$(display_name "$to")"

    case "$type" in
        handoff) title="$from_label a confié une tâche à $to_label";;
        ask)
            if [ -n "$ref" ]; then
                title="$from_label a répondu à $to_label"
            else
                title="$from_label a envoyé un message à $to_label"
            fi
            ;;
        done)
            if [ "$to" = "user" ]; then
                title="$from_label a terminé son travail"
            else
                title="$from_label a terminé son travail pour $to_label"
            fi
            ;;
        block)
            if [ "$to" = "user" ]; then
                title="$from_label est bloqué"
            else
                title="$from_label a signalé un blocage à $to_label"
            fi
            ;;
        timeout) title="Le travail de $to_label a expiré";;
    esac

    subtitle="$label"
    target="$(notification_target "$to")"

    if [ -n "$target" ]; then
        cmux notify --title "$title" --subtitle "$subtitle" --body "$body" --surface "$target" >/dev/null 2>&1 && return 0
    fi
    if [ -n "${CMUX_WORKSPACE_ID:-}" ]; then
        cmux notify --title "$title" --subtitle "$subtitle" --body "$body" --workspace "$CMUX_WORKSPACE_ID" >/dev/null 2>&1 && return 0
    fi
    cmux notify --title "$title" --subtitle "$subtitle" --body "$body" >/dev/null 2>&1 || {
        echo "agent-notify: cmux notify failed for event $(printf '%s\n' "$event" | jq -r '.id // "unknown"')" >&2
    }
}

process_pending() {
    local cursor total line_number start_line event
    cursor=0
    if [ -f "$cursor_file" ]; then
        cursor="$(sed -n '1p' "$cursor_file" 2>/dev/null || printf '0')"
    fi
    case "$cursor" in ''|*[!0-9]*) cursor=0;; esac

    total="$(wc -l < "$AGENT_BUS_FILE" | tr -d ' ')"
    [ "$total" -ge "$cursor" ] || cursor=0
    [ "$total" -gt "$cursor" ] || return 0

    line_number="$cursor"
    start_line=$((cursor + 1))
    while IFS= read -r event || [ -n "$event" ]; do
        line_number=$((line_number + 1))
        if printf '%s\n' "$event" | jq -e 'type == "object" and (.id | type == "string")' >/dev/null 2>&1; then
            send_notification "$event"
        fi
        write_cursor "$line_number"
    done < <(tail -n "+$start_line" "$AGENT_BUS_FILE")
}

interval=1
label=""
replay=0

agent_bus_parse_common "$@"
if [ "${#AGENT_BUS_REMAINING_ARGS[@]}" -gt 0 ]; then
    set -- "${AGENT_BUS_REMAINING_ARGS[@]}"
else
    set --
fi

[ $# -ge 1 ] || usage
command="$1"
shift

while [ $# -gt 0 ]; do
    case "$1" in
        --interval)
            [ $# -ge 2 ] || usage
            interval="$2"
            shift 2
            ;;
        --label)
            [ $# -ge 2 ] || usage
            label="$2"
            shift 2
            ;;
        --replay)
            replay=1
            shift
            ;;
        --*) echo "agent-notify: unknown flag '$1'" >&2; exit 2;;
        *) usage;;
    esac
done

case "$interval" in ''|*[!0-9.]*) echo "agent-notify: --interval must be a positive number" >&2; exit 2;; esac
if ! jq -en --arg interval "$interval" '($interval | tonumber) > 0' >/dev/null 2>&1; then
    echo "agent-notify: --interval must be a positive number" >&2
    exit 2
fi

case "$command" in
    enable|disable|ensure|start|stop|status|once|run) ;;
    *) usage;;
esac

if [ "$command" = "disable" ] || [ "$command" = "stop" ] || [ "$command" = "status" ]; then
    replay=0
fi
if [ "$command" != "enable" ] && [ "$command" != "start" ] && [ "$command" != "once" ] && [ "$replay" -eq 1 ]; then
    echo "agent-notify: --replay is only valid with enable, start, or once" >&2
    exit 2
fi

agent_bus_set_paths
agent_bus_need_existing
agent_bus_need_agents
command -v cmux >/dev/null 2>&1 || { echo "agent-notify: cmux is required" >&2; exit 1; }

state_dir="$AGENT_BUS_DIR_EFFECTIVE/notifier"
pid_file="$state_dir/pid"
cursor_file="$state_dir/cursor"
log_file="$state_dir/daemon.log"
disabled_file="$state_dir/disabled"
label_file="$state_dir/label"
workspace_id="${CMUX_WORKSPACE_ID:-}"
if [ -z "$workspace_id" ] && [ "$AGENT_BUS_SCOPE_EFFECTIVE" = "workspace" ]; then
    workspace_id="$(basename "$AGENT_BUS_DIR_EFFECTIVE")"
fi
bus_key="$(printf '%s' "$AGENT_BUS_DIR_EFFECTIVE" | cksum | awk '{print $1}')"
service_label="com.cmux-bus.notify.$bus_key"
launch_domain="gui/$(id -u)"
launch_agents_dir="${AGENT_BUS_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
plist_file="$launch_agents_dir/$service_label.plist"
runtime_dir="${AGENT_BUS_NOTIFY_RUNTIME_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/cmux-bus/bin}"
runtime_script="$runtime_dir/agent-notify"
socket_path="${CMUX_SOCKET_PATH:-$(agent_bus_state_home)/cmux/cmux-$(id -u).sock}"
mkdir -p "$state_dir"

case "$command" in
    status)
        if [ -f "$disabled_file" ]; then
            echo "agent-notify: disabled for $AGENT_BUS_DIR_EFFECTIVE"
            exit 0
        fi
        if launch_service_running; then
            echo "agent-notify: enabled and running for $AGENT_BUS_DIR_EFFECTIVE"
            exit 0
        fi
        if is_running; then
            echo "agent-notify: running (pid $pid) for $AGENT_BUS_DIR_EFFECTIVE"
            exit 0
        fi
        echo "agent-notify: enabled by default but not running for $AGENT_BUS_DIR_EFFECTIVE"
        exit 1
        ;;
    disable|stop)
        disable_persistent
        ;;
    enable|start)
        enable_persistent 1
        ;;
    ensure)
        if [ -f "$disabled_file" ]; then
            echo "agent-notify: disabled for $AGENT_BUS_DIR_EFFECTIVE"
            exit 0
        fi
        if launch_service_running; then
            exit 0
        fi
        if [ -f "$plist_file" ]; then
            enable_persistent 0
        else
            enable_persistent 1
        fi
        ;;
    once)
        resolve_label
        if [ "$replay" -eq 1 ]; then
            write_cursor 0
        fi
        process_pending
        ;;
    run)
        resolve_label
        if is_running && [ "$pid" != "$$" ]; then
            echo "agent-notify: already running (pid $pid)" >&2
            exit 1
        fi
        printf '%s\n' "$$" > "$pid_file"
        trap 'current=$(sed -n "1p" "$pid_file" 2>/dev/null || true); [ "$current" != "$$" ] || rm -f "$pid_file"' EXIT
        trap 'exit 0' INT TERM
        while :; do
            process_pending
            sleep "$interval"
        done
        ;;
esac
