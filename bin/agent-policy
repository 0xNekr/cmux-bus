#!/usr/bin/env bash
# agent-policy [show|path|init|check <caller> <provider>] [--user|--repo] [--json] [--force]
#
# Inspect and scaffold the spawn call policy — who may CREATE which provider via
# agent-spawn / agent-fleet. Resolution: built-in default (open) deep-merged with
# a user policy then a repo policy (repo wins). Override with $AGENT_BUS_POLICY_FILE.
#
# Policy schema:
#   { "spawn": {
#       "mode": "open" | "lead-only" | "matrix",
#       "rules": { "<provider>|lead|default": ["<provider>", ...] | ["*"] }
#   } }

set -euo pipefail

AGENT_CMD="agent-policy"
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
    script_dir="$(cd "$(dirname "$script_path")" && pwd)"
    link_target="$(readlink "$script_path")"
    case "$link_target" in
        /*) script_path="$link_target";;
        *)  script_path="$script_dir/$link_target";;
    esac
done
. "$(cd "$(dirname "$script_path")" && pwd)/agent-lib"

usage() {
    cat >&2 <<EOF
usage: agent-policy [show|path|init|check <caller> <provider>] [--user|--repo] [--json] [--force]
  show                       print the resolved spawn policy (built-in + user + repo)
  path [--user|--repo]       print the user (default) or repo policy file path
  init [--user|--repo]       scaffold a starter policy file (--force to overwrite)
  check <caller> <provider>  test a rule; <caller> is a provider, "lead", or "default"

  Modes: open (anyone may spawn), lead-only (only the lead), matrix (consult rules).
EOF
    exit 2
}

action="show"
level="user"
json=0
force=0
chk_caller=""
chk_provider=""
while [ $# -gt 0 ]; do
    case "$1" in
        show|path|init) action="$1";;
        check)
            action="check"
            [ $# -ge 3 ] || { echo "agent-policy: check needs <caller> <provider>" >&2; usage; }
            chk_caller="$2"; chk_provider="$3"; shift 2
            ;;
        --user) level="user";;
        --repo) level="repo";;
        --json) json=1;;
        --force) force=1;;
        *) usage;;
    esac
    shift
done

level_file() {
    if [ "$level" = "repo" ]; then
        agent_policy_repo_file || {
            echo "agent-policy: --repo requires running inside a git repository" >&2
            exit 1
        }
    else
        agent_policy_user_file
    fi
}

starter_policy() {
    cat <<'JSON'
{
  "spawn": {
    "mode": "matrix",
    "rules": {
      "lead": ["*"],
      "claude": ["codex", "opencode"],
      "codex": [],
      "opencode": [],
      "default": []
    }
  }
}
JSON
}

case "$action" in
    path)
        level_file
        ;;
    check)
        decision="$(agent_spawn_decision_key "$chk_caller" "$chk_provider")"
        if [ "$decision" = "allow" ]; then
            echo "allow: '$chk_caller' may spawn '$chk_provider'"
        else
            echo "${decision/deny:/deny:}"
            exit 1
        fi
        ;;
    init)
        file="$(level_file)"
        if [ -f "$file" ] && [ "$force" -eq 0 ]; then
            echo "agent-policy: $file already exists — pass --force to overwrite" >&2
            exit 1
        fi
        mkdir -p "$(dirname "$file")"
        starter_policy > "$file"
        echo "agent-policy: wrote starter $level policy to $file"
        echo "agent-policy: edit it, then check with 'agent-policy show'"
        ;;
    show)
        if [ "$json" -eq 1 ]; then
            agent_policy_json
            exit 0
        fi
        user="$(agent_policy_user_file)"
        repo="$(agent_policy_repo_file || true)"
        echo "agent-policy: sources (later wins):"
        echo "  built-in: open (anyone may spawn)"
        echo "  user:     $user $([ -f "$user" ] && echo '[present]' || echo '[absent]')"
        if [ -n "$repo" ]; then
            echo "  repo:     $repo $([ -f "$repo" ] && echo '[present]' || echo '[absent]')"
        else
            echo "  repo:     (not in a git repository)"
        fi
        [ -n "${AGENT_BUS_POLICY_FILE:-}" ] && echo "  override: \$AGENT_BUS_POLICY_FILE=$AGENT_BUS_POLICY_FILE"
        echo
        policy="$(agent_policy_json)"
        mode="$(printf '%s' "$policy" | jq -r '.spawn.mode // "open"')"
        echo "agent-policy: resolved spawn mode = $mode"
        if [ "$mode" = "matrix" ]; then
            echo "agent-policy: rules (caller -> allowed providers):"
            printf '%s' "$policy" | jq -r '
                (.spawn.rules // {}) | to_entries[]
                | "  \(.key) -> \(if (.value|length)==0 then "(none)" else (.value|join(", ")) end)"'
        fi
        ;;
esac
