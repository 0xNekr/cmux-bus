#!/usr/bin/env python3
"""Read-only cmux hook-state adapter and live Swift sidebar. Independent of the bus."""
import argparse
import datetime
import fcntl
import json
import os
from pathlib import Path
import plistlib
import shutil
import subprocess
import sys
import tempfile
import time

LABEL = 'io.cmux-bus.agent-presence'
NAME = 'agents-workspaces'
STATES = ('needs_input', 'working', 'idle', 'unknown')
MARKER = '// Generated by cmux-bus agent-presence; do not edit.\n'


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)



class ProcessIdentity:
    """Check both process existence and generation, so reused PIDs are not agents."""
    def __init__(self):
        self.cache = {}

    def __call__(self, record):
        pid = record.get('pid')
        if not isinstance(pid, int) or pid <= 0:
            return None
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return None
        expected = record.get('pidStartSeconds')
        if expected is None:
            return None
        key = (pid, expected)
        cached = self.cache.get(key)
        if cached and time.monotonic() - cached[0] < 5:
            return cached[1]
        env = dict(os.environ, LC_ALL='C')
        proc = subprocess.run(['ps', '-p', str(pid), '-o', 'lstart='], env=env,
                              capture_output=True, text=True, timeout=2)
        try:
            started = time.mktime(time.strptime(proc.stdout.strip(), '%a %b %d %H:%M:%S %Y'))
            alive = abs(started - float(expected)) < 2
        except (ValueError, TypeError):
            alive = None
        self.cache[key] = (time.monotonic(), alive)
        if len(self.cache) > 512:
            self.cache = {key: self.cache[key]}
        return alive


class CodexTurns:
    """Incremental lifecycle-only projection. No messages or tool arguments retained."""
    def __init__(self):
        self.files = {}

    def read(self, record):
        filename = record.get('transcriptPath')
        if not filename:
            return None
        path = Path(filename)
        try:
            stat = path.stat()
            previous = self.files.get(filename)
            if not previous or previous['inode'] != stat.st_ino or stat.st_size < previous['offset']:
                previous = {'inode': stat.st_ino, 'offset': 0, 'state': None, 'at': 0, 'turn': None, 'pending': set(), 'async': set()}
                self.files[filename] = previous
            with path.open('rb') as stream:
                stream.seek(previous['offset'])
                while True:
                    start = stream.tell()
                    line = stream.readline()
                    if not line:
                        break
                    if not line.endswith(b'\n'):
                        stream.seek(start)
                        break
                    try:
                        event = json.loads(line)
                        payload = event.get('payload', {})
                        at = datetime.datetime.fromisoformat(event['timestamp'].replace('Z', '+00:00')).timestamp()
                        kind = payload.get('type')
                        call = payload.get('call_id', payload.get('callId', 'question'))
                        if event.get('type') == 'response_item':
                            name = str(payload.get('name', '')).split('.')[-1]
                            if kind in ('function_call', 'custom_tool_call') and name in ('request_user_input', 'request_user_input_async'):
                                previous['pending'].add(call)
                                if name.endswith('_async'):
                                    previous['async'].add(call)
                                previous.update(at=at)
                            elif kind in ('function_call_output', 'custom_tool_call_output') and call in previous['pending']:
                                if call in previous['async']:
                                    output = payload.get('output')
                                    if isinstance(output, str):
                                        try:
                                            output = json.loads(output)
                                        except ValueError:
                                            output = None
                                    if isinstance(output, dict) and output.get('accepted') is True:
                                        continue
                                previous['pending'].discard(call)
                                previous['async'].discard(call)
                                previous.update(at=at)
                            elif kind == 'message' and payload.get('role') == 'user':
                                previous['pending'].clear()
                                previous['async'].clear()
                                previous.update(at=at)
                            continue
                        if event.get('type') != 'event_msg':
                            continue
                        turn = payload.get('turn_id')
                        if kind == 'task_started':
                            previous['pending'].clear()
                            previous['async'].clear()
                            previous.update(state='working', at=at, turn=turn)
                        elif kind in ('request_user_input', 'exec_approval_request', 'apply_patch_approval_request'):
                            if not turn or not previous['turn'] or turn == previous['turn']:
                                previous['pending'].add(call)
                                previous.update(at=at)
                        elif kind in ('task_complete', 'task_completed', 'turn_complete', 'turn_aborted') and (not turn or not previous['turn'] or turn == previous['turn']):
                            previous['pending'].intersection_update(previous['async'])
                            previous.update(state='idle', at=at, turn=turn)
                    except (ValueError, KeyError, TypeError, AttributeError):
                        continue
                previous['offset'] = stream.tell()
            state = 'needs_input' if previous['pending'] else previous['state']
            return {'state': state, 'at': previous['at']} if state else None
        except OSError:
            return None


def classify(record, turn=None):
    runtime = record.get('runtimeStatus')
    lifecycle = record.get('agentLifecycle')
    # Explicit current requests have priority over an in-flight turn. A newer
    # lifecycle event invalidates old needs-input status left by delayed hooks.
    if runtime in ('needsInput', 'error') or lifecycle == 'needsInput':
        if not turn or record.get('updatedAt', 0) >= turn['at']:
            return 'needs_input'
    if turn:
        return turn['state']
    if record.get('activePromptDepth', 0) or lifecycle == 'running' or runtime == 'running':
        return 'working'
    if runtime == 'idle' or lifecycle == 'idle':
        return 'idle'
    return 'unknown'


def read_records(directory):
    records, errors = [], []
    paths = sorted(directory.glob('*-hook-sessions.json'))
    for path in paths:
        try:
            obj = json.loads(path.read_text())
            if not isinstance(obj, dict) or not isinstance(obj.get('sessions'), dict):
                raise ValueError('unsupported schema')
            provider = path.name.removesuffix('-hook-sessions.json')
            for key, record in obj['sessions'].items():
                if isinstance(record, dict) and isinstance(record.get('surfaceId'), str):
                    records.append(dict(record, provider=provider, sessionId=record.get('sessionId', key)))
        except (OSError, ValueError) as error:
            errors.append(path.name + ': ' + str(error))
    if not paths:
        errors.append('No cmux hook stores found')
    return records, errors


def aggregate(tree, records, is_alive, turns):
    workspaces = []
    for window in tree.get('windows', []):
        for workspace in window.get('workspaces', []):
            surfaces = {s['id']: s for pane in workspace.get('panes', [])
                        for s in pane.get('surfaces', []) if s.get('id')}
            # Surface identity, not cwd or stored workspace: moving a terminal
            # must move its agent count without waiting for another hook.
            candidates = {}
            for record in records:
                sid = record['surfaceId']
                if sid not in surfaces:
                    continue
                alive = is_alive(record)
                if alive is False:
                    continue
                current = candidates.get(sid)
                rank = (alive is True, record.get('startedAt', 0), record.get('updatedAt', 0))
                if current is None or rank > current[0]:
                    candidates[sid] = (rank, record, alive)
            agents = []
            for sid, (_, record, alive) in candidates.items():
                turn = turns.read(record) if record['provider'] == 'codex' else None
                state = classify(record, turn) if alive is True else 'unknown'
                agents.append({'surface': sid, 'session': record['sessionId'],
                               'provider': record['provider'], 'state': state})
            counts = {state: sum(a['state'] == state for a in agents) for state in STATES}
            targets = {state: next((a['surface'] for a in agents if a['state'] == state), '') for state in STATES}
            workspaces.append({'id': workspace['id'], 'title': workspace.get('title', ''),
                               'counts': counts, 'targets': targets, 'agents': agents})
    return workspaces


def swift_string(value):
    # JSON escapes backslashes (including Swift interpolation), quotes and controls.
    return json.dumps(str(value), ensure_ascii=False)


def render(workspaces, now, error=False):
    # Keep expressions inline: cmux 0.64's runtime drops local let bindings
    # inside repeated conditional views, although its validator accepts them.
    agents = {a['surface']: a for w in workspaces for a in w['agents']}
    def matching(state):
        ids = [sid for sid, a in agents.items() if a['state'] == state]
        literal = '[' + ', '.join(swift_string(sid) for sid in ids or ['__none__']) + ']'
        return 'w.tabs.filter { ' + literal + '.contains($0.id) }'
    lines = [MARKER, 'VStack(alignment: .leading, spacing: 8) {',
             '    Text("Workspaces").font(.headline)', '    Divider()',
             '    Reorderable(workspaces, move: "workspace.reorder") { w in',
             '        VStack(alignment: .leading, spacing: 5) {',
             '            Text(w.title).font(.headline).lineLimit(1)',
             '                .onTapGesture { cmux("workspace.select", workspace_id: w.id) }']
    if error:
        lines.append('            Text("Suivi indisponible").font(.caption).foregroundColor("#FF9F0A")')
    else:
        lines += [f'            if clock.epoch - {int(now)} > 15 {{',
                  '                Text("Suivi interrompu").font(.caption).foregroundColor("#FF9F0A")',
                  '            } else {']
        for state, color, label in [('needs_input','#FF9F0A','en attente de réponse'),
                                     ('working','#64B5F6','au travail'),('idle','secondary','inactif')]:
            match = matching(state)
            count = match + '.count'
            plural = '\\(' + count + ' > 1 ? "s" : "")'
            if state == 'idle':
                label += plural
            text = '\\(' + count + ') agent' + plural + ' ' + label
            lines += [f'                Text("{text}").font(.caption).foregroundColor("{color}").lineLimit(1)',
                      f'                    .opacity({count} > 0 ? 1 : 0.45)',
                      '                    .onTapGesture {',
                      '                        cmux("workspace.select", workspace_id: w.id)',
                      f'                        if {count} > 0 {{ cmux("surface.focus", surface_id: {match}.first.id) }}',
                      '                    }']
        unknown = matching('unknown') + '.count'
        lines += [f'                if {unknown} > 0 {{',
                  f'                    Text("\\({unknown}) état(s) inconnu(s)").font(.caption).foregroundColor("#FF9F0A")',
                  '                }', '            }']
    lines += ['        }', '        .padding(8)',
              '        .frame(maxWidth: .infinity, alignment: .leading)',
              '        .background(w.selected ? "#0A84FF26" : "#00000000")',
              '        .cornerRadius(8)', '    }', '    Spacer()', '}']
    return '\n'.join(lines) + '\n'


class Monitor:
    def __init__(self, args):
        self.args = args
        self.alive = ProcessIdentity()
        self.turns = CodexTurns()
        self.last_content = None
        self.last_write = 0
        self.last_error = None

    def tick(self):
        records, errors = read_records(self.args.hook_dir)
        # The sidebar owns the authoritative live terminal inventory. Never
        # connect from launchd: cmuxOnly access mode intentionally rejects it.
        # Synthetic grouping is diagnostic only; rendering joins by surface.
        groups = {}
        for r in records:
            groups.setdefault(r.get('workspaceId', ''), set()).add(r['surfaceId'])
        tree = {'windows': [{'workspaces': [
            {'id': wid, 'panes': [{'surfaces': [{'id': sid} for sid in surfaces]}]}
            for wid, surfaces in groups.items()]}]}
        workspaces = aggregate(tree, records, self.alive, self.turns)
        now = time.time()
        snapshot = {'workspaces': workspaces, 'errors': errors}
        signature = json.dumps(snapshot, sort_keys=True)
        if signature != self.last_content or now - self.last_write >= 5:
            atomic_write(self.args.sidebar, render(workspaces, now, bool(errors)))
            atomic_write(self.args.state_dir / 'snapshot.json', json.dumps(dict(snapshot, observedAt=now), indent=2))
            self.last_content, self.last_write = signature, now
        message = '; '.join(errors)
        if message != self.last_error:
            if message:
                print(message, file=sys.stderr, flush=True)
            self.last_error = message
        return snapshot


def enable(args):
    if sys.platform != 'darwin':
        raise RuntimeError('Persistent service installation currently requires macOS launchd')
    if args.sidebar.exists() and not args.sidebar.read_text().startswith(MARKER):
        raise RuntimeError('Sidebar already exists and is not owned by agent-presence')
    runtime = Path.home() / '.local/share/cmux-bus/bin/agent-presence'
    runtime.parent.mkdir(parents=True, exist_ok=True)
    if Path(__file__).resolve() != runtime.resolve():
        shutil.copy2(__file__, runtime)
    runtime.chmod(0o755)
    args.state_dir.mkdir(parents=True, exist_ok=True)
    plist_path = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')
    plist_path.parent.mkdir(parents=True, exist_ok=True)
    # No workspace/surface environment: this is a global read-only observer.
    job = {'Label': LABEL, 'ProgramArguments': [sys.executable, str(runtime), 'watch',
        '--cmux', args.cmux, '--hook-dir', str(args.hook_dir), '--sidebar', str(args.sidebar),
        '--state-dir', str(args.state_dir)], 'RunAtLoad': True, 'KeepAlive': True,
        'ThrottleInterval': 10, 'ProcessType': 'Background',
        'StandardOutPath': str(args.state_dir / 'service.log'),
        'StandardErrorPath': str(args.state_dir / 'service.log'),
        'EnvironmentVariables': {'PATH': '/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin'}}
    if os.environ.get('CMUX_SOCKET_PATH'):
        job['EnvironmentVariables']['CMUX_SOCKET_PATH'] = os.environ['CMUX_SOCKET_PATH']
    domain = 'gui/' + str(os.getuid())
    subprocess.run(['launchctl', 'bootout', domain + '/' + LABEL], capture_output=True)
    plist_path.write_bytes(plistlib.dumps(job))
    initial = Monitor(args).tick()
    if initial['errors']:
        raise RuntimeError('; '.join(initial['errors']))
    subprocess.run([args.cmux, 'sidebar', 'validate', NAME], check=True)
    subprocess.run(['launchctl', 'bootstrap', domain, str(plist_path)], check=True)
    print('Presence service enabled. Select with: cmux sidebar select ' + NAME)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['once', 'watch', 'enable', 'disable', 'status'])
    parser.add_argument('--cmux', default=shutil.which('cmux') or 'cmux')
    parser.add_argument('--hook-dir', type=Path, default=Path(os.environ.get('CMUX_AGENT_HOOK_STATE_DIR', str(Path.home()/'.cmuxterm'))))
    parser.add_argument('--sidebar', type=Path, default=Path.home()/'.config/cmux/sidebars'/ (NAME + '.swift'))
    parser.add_argument('--state-dir', type=Path, default=Path.home()/'.local/state/cmux-bus/presence')
    args = parser.parse_args()
    if args.command == 'enable':
        enable(args)
    elif args.command == 'disable':
        subprocess.run(['launchctl', 'bootout', 'gui/' + str(os.getuid()) + '/' + LABEL], capture_output=True)
        (Path.home()/'Library/LaunchAgents'/(LABEL+'.plist')).unlink(missing_ok=True)
        print('Presence stopped. Select Default Workspaces in the cmux sidebar menu to restore the native view.')
    elif args.command == 'status':
        print((args.state_dir / 'snapshot.json').read_text())
    else:
        if args.sidebar.exists() and not args.sidebar.read_text().startswith(MARKER):
            raise RuntimeError('Refusing to overwrite an unowned sidebar')
        args.state_dir.mkdir(parents=True, exist_ok=True)
        with (args.state_dir/'monitor.lock').open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            monitor = Monitor(args)
            while True:
                snapshot = monitor.tick()
                if args.command == 'once':
                    print(json.dumps(snapshot, indent=2))
                    return
                time.sleep(2)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print('agent-presence: ' + str(error), file=sys.stderr)
        sys.exit(1)
